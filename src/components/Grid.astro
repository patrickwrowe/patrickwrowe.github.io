---
// A matrix of rendered panels inside a Plate — restructure spec §6.2 and §7.
//
// One PNG per panel, laid out `columnLabels.length` across in the order given. The
// labels are text, not pixels, and they label the axes the way the SVG charts do
// (figure_style.py): bare ticks under one `columnTitle` that carries the unit, and
// `rowLabels` down the left when there is more than one row worth naming. A cell is
// then only its picture, so a row of seven is a row of seven pictures and not seven
// pictures under fourteen lines of type.
//
// `weights` gives a row of panels that share a scale cells in proportion to what
// they show (the graphitisation density row: cell edges in ångström), bottom-aligned,
// so the layout itself shows the cell shrinking and no panel sits in empty ground.
//
// The column count holds at every width. Until the plate breaks out to its full
// measure at 1000 px, every column is at least 100 px wide (the spec's phone-width
// floor; with weights, 3.1 px per unit of weight, which holds the smallest density
// cell at 100 px) and a grid wider than its plate scrolls sideways with the row
// labels held at the left edge, so the matrix keeps its shape. Above 1000 px the
// floor comes off, which is where the widest matrix first fits the 864 px plate.
//
// Whether the panels of a plate share a scale is the render manifest's business and
// the caption's to state; the grid draws each picture at the width of its cell.
//
// The whole grid is one image to assistive technology: `alt` states the trend, the
// Plate caption gives the parameters, and the per-panel images are decorative.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  /** Subdirectory of src/content/work/figures/ holding the panels. */
  dir: string;
  /** Panel files, row by row. */
  panels: string[];
  /** One tick per column: a bare value, the unit lives in `columnTitle`. */
  columnLabels: string[];
  /** The axis title over the columns, with its unit ("density / g cm⁻³"). */
  columnTitle?: string;
  /** One heading per row; omit for a grid whose rows need no name. */
  rowLabels?: string[];
  /** Relative cell widths, one per column, for panels that share a scale. */
  weights?: number[];
  /** The trend the grid shows, in one sentence. */
  alt: string;
}
const { dir, panels, columnLabels, columnTitle, rowLabels = [], weights, alt } = Astro.props;
const columns = columnLabels.length;
if (panels.length % columns !== 0) {
  throw new Error(`Grid: ${panels.length} panels do not fill rows of ${columns}`);
}
if (rowLabels.length > 0 && rowLabels.length * columns !== panels.length) {
  throw new Error(`Grid: ${rowLabels.length} row labels for ${panels.length / columns} rows`);
}
if (weights && weights.length !== columns) {
  throw new Error(`Grid: ${weights.length} weights for ${columns} columns`);
}

// The panel tracks: equal shares, or shares in proportion to the weights with a floor
// of --floor-per-weight each (3.1 px a unit under 1000 px, nothing above; set in CSS).
const tracks = weights
  ? weights.map((weight) => `minmax(calc(${weight} * var(--floor-per-weight)), ${weight}fr)`).join(" ")
  : `repeat(${columns}, minmax(var(--floor), 1fr))`;

// Panel widths for `sizes`: the plate is at most --measure-figure (54rem = 864 px)
// wide less its padding, and a column is never narrower than the 100 px floor.
const plateWidth = 864 - 24;
const weightSum = weights ? weights.reduce((sum, weight) => sum + weight, 0) : columns;
const sizesFor = (column: number): string => {
  const share = weights ? weights[column] / weightSum : 1 / columns;
  return `${Math.max(100, Math.ceil(plateWidth * share))}px`;
};

const images = import.meta.glob<ImageMetadata>("/src/content/work/figures/**/*.png", {
  eager: true,
  import: "default",
});
const resolve = (file: string): ImageMetadata => {
  const key = `/src/content/work/figures/${dir}/${file}`;
  const image = images[key];
  if (!image) throw new Error(`Grid: no panel at ${key}`);
  return image;
};
// Never ask the image service to enlarge a panel.
const widthsFor = (image: ImageMetadata): number[] =>
  [320, 640, 800, 1200].filter((width) => width < image.width).concat(image.width);
---

<div
  class:list={["grid", rowLabels.length > 0 && "grid--rows", weights && "grid--weighted"]}
  role="img"
  aria-label={alt}
  style={`--tracks: ${tracks}`}
>
  {columnTitle && <span class="label grid__title">{columnTitle}</span>}
  {rowLabels.length > 0 && <span />}
  {columnLabels.map((label) => <span class="label grid__column-label">{label}</span>)}
  {
    panels.map((file, index) => (
      <>
        {rowLabels.length > 0 && index % columns === 0 && (
          <span class="label grid__row-label">{rowLabels[index / columns]}</span>
        )}
        <Image
          src={resolve(file)}
          alt=""
          widths={widthsFor(resolve(file))}
          sizes={sizesFor(index % columns)}
          quality="max"
          loading="lazy"
        />
      </>
    ))
  }
</div>

<style>
  .grid {
    --floor: 100px;
    --floor-per-weight: 3.1px;
    display: grid;
    grid-template-columns: var(--tracks);
    gap: 0.5rem;
    align-items: center;
    padding: 1rem 0.75rem;
    /* Columns never shrink below the floor; a plate narrower than the matrix scrolls. */
    overflow-x: auto;
  }
  .grid--rows {
    grid-template-columns: auto var(--tracks);
  }
  /* Panels in proportion to their cell edge stand on a common baseline. */
  .grid--weighted {
    align-items: end;
  }
  /* The plate's breakout width (Plate.astro): the matrix fits, so the floor comes off. */
  @media (min-width: 1000px) {
    .grid {
      --floor: 0px;
      --floor-per-weight: 0px;
    }
  }
  .grid > :global(img) {
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }
  .grid__title,
  .grid__column-label,
  .grid__row-label {
    text-transform: none; /* "g cm⁻³" and "K" are not shouted */
    letter-spacing: 0; /* tracking is for capitals; these are figures, like a chart's ticks */
  }
  /* A row label is short and pinned; a column label may wrap in a 100 px phone cell. */
  .grid__row-label {
    white-space: nowrap;
  }
  .grid__column-label {
    text-wrap: balance;
  }
  .grid__title {
    grid-column: 1 / -1;
    text-align: center;
    margin-bottom: 0.25rem;
  }
  .grid--rows .grid__title {
    grid-column: 2 / -1;
  }
  /* While the grid can scroll, a title centred over the whole matrix would sit
   * off-screen; it is pinned to the left edge instead, like the row labels. */
  @media (max-width: 999px) {
    .grid__title {
      justify-self: start;
      position: sticky;
      left: 0;
      background: var(--plate);
    }
  }
  .grid__column-label {
    text-align: center;
    align-self: end;
  }
  .grid__row-label {
    text-align: right;
    padding-right: 0.25rem;
    /* Pinned at the left edge while the matrix scrolls under it on a phone. */
    position: sticky;
    left: 0;
    background: var(--plate);
  }
</style>
