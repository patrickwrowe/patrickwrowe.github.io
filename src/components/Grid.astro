---
// A matrix of rendered panels inside a Plate — restructure spec §6.2 and §7.
//
// One PNG per panel, laid out `columnLabels.length` across in the order given. The
// labels are text, not pixels, and they name the axes rather than the cells:
// `columnLabels` run along the top and `rowLabels`, when there is more than one row
// worth naming, down the left. A cell is then only its picture, so a row of eight is
// a row of eight pictures and not eight pictures under sixteen lines of type.
//
// The column count holds at every width. Until the plate breaks out to its full
// measure at 1000 px, every column is at least 100 px wide (the spec's phone-width
// floor) and a grid wider than its plate scrolls sideways with the row labels held
// at the left edge, so the matrix keeps its shape: size across, temperature down,
// and a column still reads as one series. Reflowing to three columns kept every
// panel in view and lost the matrix; above 1000 px the widest matrix (eight columns
// and a row-label column) fits the 864 px plate only without the floor.
//
// Whether the panels of a plate share a scale is the render manifest's business and
// the caption's to state; the grid draws each picture at the width of its cell.
//
// The whole grid is one image to assistive technology: `alt` states the trend, the
// Plate caption gives the parameters, and the per-panel images are decorative.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  /** Subdirectory of src/content/work/figures/ holding the panels. */
  dir: string;
  /** Panel files, row by row. */
  panels: string[];
  /** One heading per column. */
  columnLabels: string[];
  /** One heading per row; omit for a grid whose rows need no name. */
  rowLabels?: string[];
  /** The trend the grid shows, in one sentence. */
  alt: string;
}
const { dir, panels, columnLabels, rowLabels = [], alt } = Astro.props;
const columns = columnLabels.length;
if (panels.length % columns !== 0) {
  throw new Error(`Grid: ${panels.length} panels do not fill rows of ${columns}`);
}
if (rowLabels.length > 0 && rowLabels.length * columns !== panels.length) {
  throw new Error(`Grid: ${rowLabels.length} row labels for ${panels.length / columns} rows`);
}

// Panel width for `sizes`: the plate is at most --measure-figure (54rem = 864 px)
// wide, and a column is never narrower than the 100 px floor.
const sizes = `${Math.max(100, Math.ceil(864 / columns))}px`;

const images = import.meta.glob<ImageMetadata>("/src/content/work/figures/**/*.png", {
  eager: true,
  import: "default",
});
const resolve = (file: string): ImageMetadata => {
  const key = `/src/content/work/figures/${dir}/${file}`;
  const image = images[key];
  if (!image) throw new Error(`Grid: no panel at ${key}`);
  return image;
};
---

<div
  class:list={["grid", rowLabels.length > 0 && "grid--rows"]}
  role="img"
  aria-label={alt}
  style={`--columns: ${columns}`}
>
  {rowLabels.length > 0 && <span />}
  {columnLabels.map((label) => <span class="label grid__column-label">{label}</span>)}
  {
    panels.map((file, index) => (
      <>
        {rowLabels.length > 0 && index % columns === 0 && (
          <span class="label grid__row-label">{rowLabels[index / columns]}</span>
        )}
        <Image src={resolve(file)} alt="" widths={[320, 640, 800]} sizes={sizes} loading="lazy" />
      </>
    ))
  }
</div>

<style>
  .grid {
    --floor: 100px;
    display: grid;
    grid-template-columns: repeat(var(--columns), minmax(var(--floor), 1fr));
    gap: 0.5rem;
    align-items: center;
    padding: 1rem 0.75rem;
    /* Columns never shrink below the floor; a plate narrower than the matrix scrolls. */
    overflow-x: auto;
  }
  .grid--rows {
    grid-template-columns: auto repeat(var(--columns), minmax(var(--floor), 1fr));
  }
  /* The plate's breakout width (Plate.astro): the matrix fits, so the floor comes off. */
  @media (min-width: 1000px) {
    .grid {
      --floor: 0px;
    }
  }
  .grid > :global(img) {
    width: 100%;
    height: auto;
    mix-blend-mode: multiply;
  }
  .grid__column-label,
  .grid__row-label {
    text-transform: none; /* "g cm⁻³" and "K" are not shouted */
    white-space: nowrap;
  }
  .grid__column-label {
    text-align: center;
    align-self: end;
  }
  .grid__row-label {
    text-align: right;
    padding-right: 0.25rem;
    /* Pinned at the left edge while the matrix scrolls under it on a phone. */
    position: sticky;
    left: 0;
    background: var(--plate);
  }
</style>
