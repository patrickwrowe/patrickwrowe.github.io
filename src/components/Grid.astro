---
// A matrix of rendered panels inside a Plate — restructure spec §6.2 and §7.
//
// One PNG per panel, laid out `columnLabels.length` across in the order given. The
// labels are text, not pixels, and they name the axes the way the SVG charts do
// (figure_style.py): bare ticks under one `columnTitle` that carries the unit, and
// `rowLabels` down the left when there is more than one row worth naming. A cell is
// then only its picture, so a row of seven is a row of seven pictures.
//
// Every picture is a thumbnail: a button that opens the panel's full render in a
// popover (the HTML popover attributes, no script), captioned with the panel's row
// and column, as the gallery grid on an artist's site opens each work. The cell
// size therefore serves the overview; the detail is one click away.
//
// `weights` gives a row of panels that share a scale cells in proportion to what
// they show, bottom-aligned, so the layout itself shows the cell shrinking and no panel
// sits in empty ground. Each weight is the width in ångström of the panel's frame: its
// render manifest cages it at its cell edge plus a sphere diameter, and molrender's
// orthographic camera frames that cage's projected extent, which under the plate's
// tilted view is the cage's height, not its edge (the graphitisation density row;
// scripts/tests/test_article_figures.py recomputes every weight from the manifest).
//
// The column count holds at every width. Until the plate breaks out to its full
// measure at 1000 px, every column is at least 100 px wide (the spec's phone-width
// floor; with weights, --floor-per-weight per unit, 100 px for the smallest weight
// in use) and a grid wider than its plate scrolls sideways with the row labels held
// at the left edge.
//
// Styles live in src/styles/grid.css, imported by the work-article page, not by this
// component. The trade-off: a component that only MDX imports gets its scoped styles
// by a separate dev-server path, which on one of Patrick's servers delivered the
// markup without the stylesheet; importing grid.css from the page avoids that path,
// at the cost that any other page using <Grid> must import grid.css itself or render
// the grid unstyled. Whether the panels of a plate share a scale is the render
// manifest's business and the caption's to state.
//
// To assistive technology the grid is a group named by `alt`, which states the
// trend; each thumbnail is a button named "Enlarge <row>, <column>"; the images
// themselves are decorative, and the Plate caption gives the parameters.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  /** Subdirectory of src/content/work/figures/ holding the panels. */
  dir: string;
  /** Panel files, row by row. */
  panels: string[];
  /** One tick per column: a bare value, the unit lives in `columnTitle`. */
  columnLabels: string[];
  /** The axis title over the columns, with its unit after " / " ("density / g cm⁻³"). */
  columnTitle?: string;
  /** One heading per row; omit for a grid whose rows need no name. */
  rowLabels?: string[];
  /** Relative cell widths, one per column, for panels that share a scale. */
  weights?: number[];
  /** The trend the grid shows, in one sentence. */
  alt: string;
}
const { dir, panels, columnLabels, columnTitle, rowLabels = [], weights, alt } = Astro.props;
const columns = columnLabels.length;
if (panels.length % columns !== 0) {
  throw new Error(`Grid: ${panels.length} panels do not fill rows of ${columns}`);
}
if (rowLabels.length > 0 && rowLabels.length * columns !== panels.length) {
  throw new Error(`Grid: ${rowLabels.length} row labels for ${panels.length / columns} rows`);
}
if (weights && weights.length !== columns) {
  throw new Error(`Grid: ${weights.length} weights for ${columns} columns`);
}

// The panel tracks: equal shares, or shares in proportion to the weights with a floor
// of --floor-per-weight each (2.88 px a unit under 1000 px, nothing above; grid.css).
const tracks = weights
  ? weights.map((weight) => `minmax(calc(${weight} * var(--floor-per-weight)), ${weight}fr)`).join(" ")
  : `repeat(${columns}, minmax(var(--floor), 1fr))`;

// Thumbnail widths for `sizes`: the plate is at most --measure-figure (54rem = 864 px)
// wide less its padding, and a column is never narrower than the 100 px floor.
const plateWidth = 864 - 24;
const weightSum = weights ? weights.reduce((sum, weight) => sum + weight, 0) : columns;
const sizesFor = (column: number): string => {
  const share = weights ? weights[column] / weightSum : 1 / columns;
  return `${Math.max(100, Math.ceil(plateWidth * share))}px`;
};

// Each `widths` list ends with the panel's own width: Astro drops every width above an
// imported image's own and adds that one (astro/dist/assets/services/service.js,
// getSrcSet), so the image service is never asked to enlarge a panel.
const images = import.meta.glob<ImageMetadata>("/src/content/work/figures/**/*.png", {
  eager: true,
  import: "default",
});
const resolve = (file: string): ImageMetadata => {
  const key = `/src/content/work/figures/${dir}/${file}`;
  const image = images[key];
  if (!image) throw new Error(`Grid: no panel at ${key}`);
  return image;
};

// The popover's caption: "<row>, <column> <unit>", the unit taken from the title.
const unit = columnTitle?.includes(" / ") ? columnTitle.split(" / ")[1] : "";
const captionFor = (index: number): string => {
  const column = `${columnLabels[index % columns]}${unit ? ` ${unit}` : ""}`;
  const row = rowLabels[Math.floor(index / columns)];
  return row ? `${row}, ${column}` : column;
};
const slug = (text: string): string => text.toLowerCase().replace(/[^a-z0-9]+/g, "-");
const idFor = (file: string): string => `panel-${slug(dir)}-${slug(file.replace(/\.png$/, ""))}`;
---

<div
  class:list={["grid", rowLabels.length > 0 && "grid--rows", weights && "grid--weighted"]}
  role="group"
  aria-label={alt}
  style={`--tracks: ${tracks}`}
>
  {columnTitle && <span class="label grid__title">{columnTitle}</span>}
  {rowLabels.length > 0 && <span />}
  {columnLabels.map((label) => <span class="label grid__column-label">{label}</span>)}
  {
    panels.map((file, index) => {
      const image = resolve(file);
      const id = idFor(file);
      const caption = captionFor(index);
      return (
        <>
          {rowLabels.length > 0 && index % columns === 0 && (
            <span class="label grid__row-label">{rowLabels[index / columns]}</span>
          )}
          <button type="button" class="grid__thumb" popovertarget={id} aria-label={`Enlarge ${caption}`}>
            <Image
              src={image}
              alt=""
              widths={[320, 640, 800, image.width]}
              sizes={sizesFor(index % columns)}
              quality="max"
              loading="lazy"
            />
          </button>
          <figure
            id={id}
            class="grid__large"
            popover="auto"
            aria-label={caption}
            style={`--intrinsic-width: ${image.width}px`}
          >
            <Image
              src={image}
              alt=""
              widths={[800, 1200, image.width]}
              sizes="min(92vw, 1200px)"
              quality="max"
              loading="lazy"
            />
            <figcaption class="label grid__large-label">{caption}</figcaption>
            <button type="button" class="label grid__close" popovertarget={id} popovertargetaction="hide" autofocus>
              Close
            </button>
          </figure>
        </>
      );
    })
  }
</div>
