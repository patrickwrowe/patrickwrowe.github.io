---
// Header. The name is the route home; all four top-level routes sit in the nav.
// Spec 01 §4 originally kept About out of the nav and reached it from the name —
// that was overridden, and the spec line updated to match. Not sticky: the gallery
// convention is that chrome gets out of the way.
interface Props {
  section?: "work" | "writing" | "cv" | "about";
}
const { section } = Astro.props;
---

<header class="site-head">
  <div class="shell site-head__inner">
    <a class="site-head__name" href="/">Patrick Rowe</a>
    <nav class="site-nav" aria-label="Primary">
      <a href="/work/" aria-current={section === "work" ? "page" : undefined}>Work</a>
      <a href="/writing/" aria-current={section === "writing" ? "page" : undefined}>Writing</a>
      <a href="/cv/" aria-current={section === "cv" ? "page" : undefined}>CV</a>
      <a href="/about/" aria-current={section === "about" ? "page" : undefined}>About</a>
    </nav>
  </div>
</header>

<style>
  .site-head {
    border-bottom: 1px solid var(--hairline);
  }
  .site-head__inner {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.4rem;
  }
  .site-head__name {
    font-size: var(--t-small);
    font-weight: 500;
    letter-spacing: -0.005em;
    transition: color var(--transition);
  }
  .site-head__name:hover {
    color: var(--lustre);
  }
  .site-nav {
    display: flex;
    gap: 1.75rem;
  }
  .site-nav a {
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--graphite);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition:
      color var(--transition),
      border-color var(--transition);
  }
  /* Current page and hover are different states and must stay legible apart: the
   * current page is persistent text, so it takes --ink; hover is momentary, so it
   * takes the bright accent. Both are underlined in --lustre. */
  .site-nav a[aria-current] {
    color: var(--ink);
    border-bottom-color: var(--lustre);
  }
  .site-nav a:hover {
    color: var(--lustre);
    border-bottom-color: var(--lustre);
  }
</style>
