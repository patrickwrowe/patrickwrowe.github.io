---
// Figure and caption — spec 01 §6.2.
//
// The figure sits on --plate with a mono "Fig. n" marker and a serif caption,
// separated by a hairline rule. Masked to fade at the edges so a field of material
// reads as continuing past the frame rather than being boxed.
//
// Captions are real captions: state what is shown, how it was produced, and why
// it is here.
interface Props {
  n: number;
  /** The one orchestrated moment on page load (spec 01 §5.4). Hero plate only. */
  animate?: boolean;
}
const { n, animate = false } = Astro.props;
---

<figure class="plate">
  <div class:list={["plate__frame", animate && "plate__frame--scan"]}>
    <slot />
  </div>
  <figcaption class="plate__caption">
    <span class="label plate__fig">Fig. {n}</span>
    <span class="plate__text"><slot name="caption" /></span>
  </figcaption>
</figure>

<style>
  /* Width lives on the figure, not on the frame, so the caption and its rule are
   * the same width as the artwork by construction. Sizing the frame alone is what
   * made the figure look like it was overflowing its own caption. */
  /* The bottom margin keeps the caption from butting against the paragraph after
   * it; it collapses into the next plate's larger top margin when plates stack. */
  .plate {
    margin: 0;
    margin-top: clamp(3rem, 7vw, 5rem);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .plate__frame {
    background: var(--plate);
    overflow: hidden;
    clip-path: inset(0 0 0 0);
  }
  .plate__frame :global(svg) {
    width: 100%;
    height: auto;
  }
  /* Journal figures ship on opaque white. Multiplying against --plate drops the
   * white out so the frame reads as one surface, without editing the artwork —
   * which matters for the figures we hold under a no-derivatives licence. */
  /* Full width with the height from the width/height attributes, so the box is
   * reserved before a lazy image arrives: `width: auto` resolved to 0 x 0 until
   * load, and every figure shoved the text below it down as the reader scrolled.
   * Portrait composites would otherwise run to two screens once the plate breaks
   * out of the measure, so the height is capped and `contain` keeps the intrinsic
   * ratio: a tall figure narrows inside its box rather than squashing. The video
   * takes the same box and the same multiply, so a render on a white world drops
   * onto --plate like the stills do. */
  .plate__frame :global(img),
  .plate__frame :global(video) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 85vh;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  /* A data chart inlined as SVG. --chart-em is the chart's viewBox width in units of
   * its own tick-label size (figure_style.LABEL_SIZE), so at full size its labels
   * set at exactly --t-label, the size of every other data label on the site.
   * Stretched to the full plate they came out at 15-21 px, larger than the prose. */
  .plate__frame :global(.chart) {
    max-width: calc(var(--chart-em) * var(--t-label));
    margin-inline: auto;
  }
  /* A fixed marker column, wide enough for "Fig. 15", so every caption on a page
   * starts its text at the same x; `auto` indented Fig. 10 onwards by a character. */
  .plate__caption {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    align-items: baseline;
    gap: 0 1.25rem;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--hairline);
  }
  .plate__fig {
    white-space: nowrap;
  }
  .plate__text {
    font-family: var(--serif);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--graphite);
  }
  .plate__text :global(b) {
    color: var(--ink);
    font-weight: 600;
  }
  /* A script path in a credit line is provenance, not code to copy: mono marks it
   * as data, and the prose's --plate chip would make the credit louder than the
   * caption. It may break anywhere, or a long path overruns the phone column. */
  .plate__text :global(code) {
    background: none;
    padding: 0;
    overflow-wrap: anywhere;
  }

  @media (min-width: 700px) {
    .plate {
      margin-inline: calc(var(--gutter) * -0.5);
    }
  }
  /* Journal figures are multi-panel composites; at the prose measure the panels
   * stop being readable. Past the measure the plate breaks out rightwards to
   * --measure-figure. It stops there rather than at the full shell: a figure
   * twice the width of its own text reads as a banner that the prose is wrapped
   * around, not as a figure. */
  @media (min-width: 1000px) {
    .plate {
      margin-inline: 0;
      width: min(
        var(--measure-figure),
        calc(min(var(--shell), 100vw) - var(--gutter) * 2)
      );
    }
  }
  /* A specimen field drawn with `slice` (the landing hero) is cropped to a band at
   * phone width. A chart drawn with the default `meet` keeps its own proportions:
   * forcing it to 230 px letterboxed wide charts and shrank tall ones. */
  @media (max-width: 640px) {
    .plate__frame :global(svg[preserveAspectRatio$="slice"]) {
      height: 230px;
      width: 100%;
    }
  }
  /* Below 700 px a chart shrunk to the plate's width drops its tick labels under
   * the 11 px floor (design review C1). Instead the chart keeps the natural width
   * --chart-em already sets it to, and its own frame scrolls horizontally, so the
   * labels stay the size every other data label on the page is. Grids and raster
   * images are unaffected: this targets only the inline SVG charts' wrapper. */
  /* A chart's narrow variant is hidden until the phone rule below shows it; this
   * rule comes first so that one wins at equal specificity. */
  .plate__frame :global(.chart--narrow) {
    display: none;
  }
  @media (max-width: 699px) {
    /* `:global()` must wrap the whole selector: Astro leaves it verbatim inside
     * `:has()`, which makes the selector invalid and drops the rule. */
    :global(.plate__frame:has(.chart)) {
      overflow-x: auto;
    }
    .plate__frame :global(.chart) {
      max-width: none;
      min-width: calc(var(--chart-em) * var(--t-label));
      margin-inline: 0;
    }
    /* A chart with a narrow variant beside it (`.chart--narrow`, drawn by its script to
     * fit 350 px at --t-label) shows that variant instead of scrolling. */
    :global(.plate__frame .chart:not(.chart--narrow):has(+ .chart--narrow)) {
      display: none;
    }
    .plate__frame :global(.chart--narrow) {
      display: block;
    }
    /* The marker column and its gap took 76 of 350 px, 38 characters a line; stacked,
     * the caption runs about 52 (design critique 2, finding 8). */
    .plate__caption {
      grid-template-columns: 1fr;
      row-gap: 0.25rem;
    }
  }

  /* MOTION — the entire budget for the page load. The specimen field is scanned in
   * left to right, then the ring defects register. Nothing else animates. */
  @keyframes scan-in {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes register {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .plate__frame--scan {
    animation: scan-in 1.25s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  .plate__frame--scan :global(.defects) {
    animation: register 0.7s ease-out 0.95s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .plate__frame--scan,
    .plate__frame--scan :global(.defects) {
      clip-path: none;
      opacity: 1;
    }
  }
</style>
