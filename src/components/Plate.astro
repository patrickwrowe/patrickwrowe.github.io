---
// Figure and caption — spec 01 §6.2.
//
// The figure sits on --plate with a mono "Fig. n" marker and a serif caption,
// separated by a hairline rule. Masked to fade at the edges so a field of material
// reads as continuing past the frame rather than being boxed.
//
// Captions are real captions: state what is shown, how it was produced, and why
// it is here.
interface Props {
  n: number;
  /** The one orchestrated moment on page load (spec 01 §5.4). Hero plate only. */
  animate?: boolean;
}
const { n, animate = false } = Astro.props;
---

<figure class="plate">
  <div class:list={["plate__frame", animate && "plate__frame--scan"]}>
    <slot />
  </div>
  <figcaption class="plate__caption">
    <span class="label plate__fig">Fig. {n}</span>
    <span class="plate__text"><slot name="caption" /></span>
  </figcaption>
</figure>

<style>
  /* Width lives on the figure, not on the frame, so the caption and its rule are
   * the same width as the artwork by construction. Sizing the frame alone is what
   * made the figure look like it was overflowing its own caption. */
  .plate {
    margin: 0;
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .plate__frame {
    background: var(--plate);
    overflow: hidden;
    clip-path: inset(0 0 0 0);
  }
  .plate__frame :global(svg) {
    width: 100%;
    height: auto;
  }
  /* Journal figures ship on opaque white. Multiplying against --plate drops the
   * white out so the frame reads as one surface, without editing the artwork —
   * which matters for the figures we hold under a no-derivatives licence. */
  .plate__frame :global(img) {
    width: auto;
    max-width: 100%;
    /* Portrait composites would otherwise run to two screens once the plate breaks
     * out of the measure. Height-capped and centred; the intrinsic ratio is never
     * touched, so a tall figure narrows rather than squashing. */
    max-height: 85vh;
    margin-inline: auto;
    mix-blend-mode: multiply;
  }
  .plate__frame :global(video) {
    display: block;
    width: 100%;
    height: auto;
  }
  .plate__caption {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 1.25rem;
    margin-top: 0.9rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--hairline);
  }
  .plate__fig {
    white-space: nowrap;
  }
  .plate__text {
    font-family: var(--serif);
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--graphite);
  }
  .plate__text :global(b) {
    color: var(--ink);
    font-weight: 600;
  }

  @media (min-width: 700px) {
    .plate {
      margin-inline: calc(var(--gutter) * -0.5);
    }
  }
  /* Journal figures are multi-panel composites; at the prose measure the panels
   * stop being readable. Past the measure the plate breaks out rightwards to
   * --measure-figure. It stops there rather than at the full shell: a figure
   * twice the width of its own text reads as a banner that the prose is wrapped
   * around, not as a figure. */
  @media (min-width: 1000px) {
    .plate {
      margin-inline: 0;
      width: min(
        var(--measure-figure),
        calc(min(var(--shell), 100vw) - var(--gutter) * 2)
      );
    }
  }
  @media (max-width: 640px) {
    .plate__frame :global(svg) {
      height: 230px;
      width: 100%;
    }
  }

  /* MOTION — the entire budget for the page load. The specimen field is scanned in
   * left to right, then the ring defects register. Nothing else animates. */
  @keyframes scan-in {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes register {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .plate__frame--scan {
    animation: scan-in 1.25s cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  .plate__frame--scan :global(.defects) {
    animation: register 0.7s ease-out 0.95s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .plate__frame--scan,
    .plate__frame--scan :global(.defects) {
      clip-path: none;
      opacity: 1;
    }
  }
</style>
