---
import Base from "@/layouts/Base.astro";
import cv from "@/data/cv.yaml";

// Content comes from src/data/cv.yaml. Periods are rendered as the free strings the
// source CV uses, so no date parsing or formatting happens here; the shapes below are
// asserted rather than schema-checked.
interface Entry {
  role?: string;
  qualification?: string;
  org?: string;
  location?: string;
  period: string;
  points?: string[];
  links?: { label: string; url: string }[];
}

interface Skill {
  label: string;
  value: string;
}

const experience = cv.experience as Entry[];
const education = cv.education as Entry[];
const technical = cv.technical as Skill[];
const additional = cv.additional as string[];
---

<Base
  title="CV — Patrick Rowe"
  description={cv.about}
  section="cv"
>
  <section class="shell band">
    <div class="band__head">
      <h1 class="label">Curriculum vitae</h1>
      <span class="band__more">{cv.name}{cv.postnominals ? `, ${cv.postnominals}` : ""}</span>
    </div>

    <p class="cv-about">{cv.about}</p>

    <div class="cv-block">
      <h2 class="label cv-block__head">Currently</h2>
      <div class="cv-entry">
        <span class="cv-entry__when">{cv.current.period}</span>
        <div>
          <h3 class="cv-entry__role">{cv.current.role}, {cv.current.org}</h3>
          <ul class="cv-entry__points">
            <li class="cv-entry__point">{cv.current.focus}</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="cv-block">
      <h2 class="label cv-block__head">Experience</h2>
      {
        experience.map((job) => (
          <div class="cv-entry">
            <span class="cv-entry__when">{job.period}</span>
            <div>
              <h3 class="cv-entry__role">
                {job.role}
                {job.org ? `, ${job.org}` : ""}
              </h3>
              {job.location && <p class="cv-entry__where">{job.location}</p>}
              <ul class="cv-entry__points">
                {job.points?.map((point) => <li class="cv-entry__point">{point}</li>)}
              </ul>
            </div>
          </div>
        ))
      }
    </div>

    <div class="cv-block">
      <h2 class="label cv-block__head">Education</h2>
      {
        education.map((item) => (
          <div class="cv-entry">
            <span class="cv-entry__when">{item.period}</span>
            <div>
              <h3 class="cv-entry__role">
                {item.qualification}
                {item.org ? `, ${item.org}` : ""}
              </h3>
              {item.location && <p class="cv-entry__where">{item.location}</p>}
              <ul class="cv-entry__points">
                {item.points?.map((point) => <li class="cv-entry__point">{point}</li>)}
              </ul>
              {item.links && (
                <p class="cv-entry__links">
                  {item.links.map((link) => (
                    <a href={link.url}>{link.label} &nearr;</a>
                  ))}
                </p>
              )}
            </div>
          </div>
        ))
      }
    </div>

    <div class="cv-block">
      <h2 class="label cv-block__head">Technical</h2>
      {
        technical.map((skill) => (
          <div class="cv-entry cv-entry--tight">
            <span class="cv-entry__when">{skill.label}</span>
            <p class="cv-entry__point">{skill.value}</p>
          </div>
        ))
      }
    </div>

    <div class="cv-block">
      <h2 class="label cv-block__head">Also</h2>
      <div class="cv-entry cv-entry--tight">
        <span class="cv-entry__when"></span>
        <ul class="cv-entry__points cv-entry__points--flush">
          {additional.map((item) => <li class="cv-entry__point">{item}</li>)}
        </ul>
      </div>
    </div>

    <div class="cv-block">
      <h2 class="label cv-block__head">Contact</h2>
      <div class="cv-entry cv-entry--tight">
        <span class="cv-entry__when">Elsewhere</span>
        <p class="cv-entry__links">
          <a class="cv-entry__email" href={`mailto:${cv.links.email}`}>{cv.links.email}</a>
          <a href={cv.links.scholar}>Google Scholar &nearr;</a>
          <a href={cv.links.github}>GitHub &nearr;</a>
          <a href={cv.links.linkedin}>LinkedIn &nearr;</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .cv-about {
    font-family: var(--serif);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--ink-soft);
    max-width: var(--measure-prose);
    margin-top: 2rem;
  }
  .cv-block {
    margin-top: 3rem;
  }
  .cv-block__head {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--hairline);
  }
  .cv-entry {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0 1.5rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--hairline);
  }
  .cv-entry--tight {
    padding-block: 0.9rem;
  }
  .cv-entry__when {
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--graphite);
    padding-top: 0.3rem;
  }
  .cv-entry__role {
    font-size: var(--t-body);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .cv-entry__where {
    font-family: var(--mono);
    font-size: var(--t-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--graphite);
    margin-top: 0.35rem;
  }
  .cv-entry__points {
    margin: 0.6rem 0 0;
    padding-left: 1.1rem;
  }
  .cv-entry__points--flush {
    margin-top: 0;
  }
  .cv-entry__point {
    font-family: var(--serif);
    font-size: var(--t-small);
    line-height: 1.55;
    color: var(--ink-quiet);
    max-width: var(--measure-prose);
  }
  .cv-entry__points .cv-entry__point + .cv-entry__point {
    margin-top: 0.4rem;
  }
  .cv-entry__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 0.6rem;
  }
  .cv-entry--tight .cv-entry__links {
    margin-top: 0;
  }
  .cv-entry__links a {
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--graphite);
    transition: color var(--transition);
  }
  .cv-entry__links a:hover {
    color: var(--lustre);
  }
  /* An address is a literal, not a label — uppercasing it misrepresents it.
   * Needs to out-specify `.cv-entry__links a`, hence the compound selector. */
  .cv-entry__links a.cv-entry__email {
    text-transform: none;
    letter-spacing: 0.02em;
  }
  @media (max-width: 640px) {
    .cv-entry {
      grid-template-columns: 1fr;
    }
    .cv-entry__when {
      padding-top: 0;
      margin-bottom: 0.5rem;
    }
    .cv-entry--tight .cv-entry__when:empty {
      display: none;
    }
  }
</style>
