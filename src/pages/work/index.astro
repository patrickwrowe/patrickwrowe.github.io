---
import { getCollection } from "astro:content";
import Base from "@/layouts/Base.astro";
import WallLabel from "@/components/WallLabel.astro";
import PubList from "@/components/PubList.astro";
import { wallLabelFields, workSort, isPublished } from "@/lib/content";
import { byYearDesc } from "@/lib/publications";

// Three bands — restructure spec §3.2. Each band label is the heading at that level, so
// it must be true of every row under it: Research holds theme articles, Projects holds
// the standalone pages (a wall clock is not research), Publications holds the record.
// Paper pages (kind: paper) are no longer listed; they are archived in session 8.
const all = (await getCollection("work", isPublished)).sort(workSort);
const themes = all.filter((entry) => entry.data.kind === "theme");
const projects = all.filter((entry) => entry.data.kind === "project");
const publications = (await getCollection("publications")).sort(byYearDesc);
---

<Base
  title="Work — Patrick Rowe"
  description="Research articles, projects and the publication record: machine learning for molecules, materials and proteins."
  section="work"
>
  <section class="shell band">
    <div class="band__head">
      <h1 class="label">Research</h1>
      <span class="band__more">{themes.length} entries</span>
    </div>
    {
      themes.map((entry) => (
        <WallLabel
          year={entry.data.year}
          title={entry.data.title}
          href={`/work/${entry.id}/`}
          fields={wallLabelFields(entry.data)}
        />
      ))
    }
  </section>

  <section class="shell band band--tight">
    <div class="band__head">
      <h2 class="label">Projects</h2>
      <span class="band__more">{projects.length} entries</span>
    </div>
    {
      projects.map((entry) => (
        <WallLabel
          year={entry.data.year}
          title={entry.data.title}
          href={`/work/${entry.id}/`}
          fields={wallLabelFields(entry.data)}
          flag={entry.data.demo ? "Live demo" : undefined}
        />
      ))
    }
  </section>

  <section class="shell band band--tight">
    <div class="band__head">
      <h2 class="label">Publications</h2>
      <span class="band__more">{publications.length} entries</span>
    </div>
    <PubList entries={publications} blurbs id="publications" />
  </section>
</Base>

<style>
  .band--tight {
    padding-top: 0;
  }
</style>
