---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import Prose from "@/layouts/Prose.astro";
import DraftNotice from "@/components/DraftNotice.astro";
import { wallLabelFields, isPublished } from "@/lib/content";

export const getStaticPaths = (async () => {
  const work = await getCollection("work", isPublished);
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Prose
  title={entry.data.title}
  description={entry.data.summary}
  section="work"
  math={entry.data.math}
  meta={entry.data.year}
  fields={wallLabelFields(entry.data)}
>
  {entry.data.stub && <DraftNotice>{entry.data.stubNote ?? "Placeholder — this page is scaffolding, not a finished account."}</DraftNotice>}
  <Content />
  {
    entry.data.links.length > 0 && (
      <p class="links">
        {entry.data.links.map((link) => (
          <a href={link.url}>{link.label} &nearr;</a>
        ))}
      </p>
    )
  }
</Prose>

<style is:global>
  .prose .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }
  .prose .links a {
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--graphite);
    border-bottom: 0;
    transition: color var(--transition);
  }
  .prose .links a:hover {
    color: var(--lustre);
  }
</style>
