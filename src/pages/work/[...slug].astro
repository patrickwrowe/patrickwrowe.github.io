---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Prose from "@/layouts/Prose.astro";
import Plate from "@/components/Plate.astro";
import "@/styles/grid.css";
import DraftNotice from "@/components/DraftNotice.astro";
import PubList from "@/components/PubList.astro";
import { wallLabelFields, isPublished } from "@/lib/content";
import { readingMinutes, byYearDesc } from "@/lib/publications";

export const getStaticPaths = (async () => {
  const work = await getCollection("work", isPublished);
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { data } = entry;

// Theme articles run to several thousand words — restructure spec §3.3. The contents
// list is generated from the rendered headings so it cannot drift from them, the meta
// row carries a reading time, and the publications the article covers are listed at
// the end from the same record that feeds the Publications band.
const isTheme = data.kind === "theme";
const contents = isTheme ? headings.filter((heading) => heading.depth === 2) : [];
const meta = isTheme ? `${data.year} · ${readingMinutes(entry.body ?? "")} MIN` : data.year;
const publicationsHere = isTheme
  ? (await getCollection("publications")).filter((pub) => pub.data.theme.id === entry.id).sort(byYearDesc)
  : [];
---

<Prose
  title={data.title}
  documentTitle={`${data.title} — Patrick Rowe`}
  description={data.summary}
  section="work"
  math={data.math}
  meta={meta}
  fields={wallLabelFields(data)}
>
  {
    data.authors && (
      <p class="authors">
        {data.authors}
        {data.doi && (
          <>
            {" · "}
            <a href={`https://doi.org/${data.doi}`}>{data.doi}</a>
          </>
        )}
      </p>
    )
  }

  {data.stub && <DraftNotice>{data.stubNote ?? "Placeholder — this page is scaffolding, not a finished account."}</DraftNotice>}

  {/* The hero is the page's largest contentful paint (restructure spec §6.2): `priority`
      makes it eager, high fetch priority and synchronously decoded, up to 1728 px for a
      54rem plate at 2x. <Image> is lazy by default. */}
  {
    data.hero && (
      <Plate n={1}>
        <Image
          src={data.hero}
          alt={data.heroAlt ?? ""}
          widths={[640, 1180, 1728]}
          sizes="(max-width: 1000px) 100vw, 864px"
          priority
        />
        <Fragment slot="caption">
          {data.heroAlt}
          {data.heroCredit && <span class="credit">{data.heroCredit}</span>}
        </Fragment>
      </Plate>
    )
  }

  {
    contents.length > 0 && (
      <nav id="contents" class="contents" aria-label="Contents">
        <p class="label">Contents</p>
        <ol>
          {contents.map((heading) => (
            <li>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </nav>
    )
  }

  <Content />

  {
    publicationsHere.length > 0 && (
      <section class="pubs-here">
        <h2 id="publications-in-this-article">Publications in this article</h2>
        <PubList entries={publicationsHere} onThemePage />
      </section>
    )
  }

  {
    data.links.length > 0 && (
      <p class="links">
        {data.links.map((link) => (
          <a href={link.url}>{link.label} &nearr;</a>
        ))}
      </p>
    )
  }
</Prose>

<style is:global>
  /* Author list on a paper page, and the Cite line that opens a theme section. Mono
     would fight the wall label directly above it, so this stays serif and small — a
     citation, not another metadata row. */
  .prose .authors {
    font-family: var(--serif);
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--graphite);
    margin-top: 0;
    margin-bottom: 2em;
    max-width: var(--measure-prose);
  }
  .prose .authors a {
    border-bottom: 1px solid var(--hairline);
  }
  .prose .cite {
    margin-top: 0.75em;
    margin-bottom: 1.5em;
  }
  .prose .credit {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--graphite);
  }
  .prose .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }
  .prose .links a {
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--graphite);
    border-bottom: 0;
    transition: color var(--transition);
  }
  .prose .links a:hover {
    color: var(--lustre);
  }

  /* Theme-article furniture — restructure spec §3.3. */
  .prose .contents {
    margin-top: 2.25rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--hairline);
  }
  .prose .contents ol {
    list-style: none;
    padding-left: 0;
    margin-top: 0.75rem;
    font-family: var(--sans);
    font-size: var(--t-small);
    line-height: 1.6;
    columns: 2;
    column-gap: 2rem;
  }
  .prose .contents li {
    break-inside: avoid;
  }
  .prose .contents li + li {
    margin-top: 0.2em;
  }
  .prose .contents a {
    border-bottom: 0;
    color: var(--ink-soft);
  }
  .prose .contents a:hover {
    color: var(--lustre);
  }
  /* The fixed return line every section ends with: `[Contents ↑](#contents)`. */
  .prose a[href="#contents"] {
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--graphite);
    border-bottom: 0;
  }
  .prose a[href="#contents"]:hover {
    color: var(--lustre);
  }
  /* The section a reader arrived at from the Publications band or a redirect. State,
     not decoration, so this is a legitimate use of the accent. */
  .prose h2:target {
    color: var(--lustre);
  }
  .prose .pubs-here {
    margin-top: 3.5rem;
  }
  .prose .pubs-here .pubs {
    padding-left: 0;
    margin-top: 1rem;
  }
  .prose .pubs-here .pub__links a {
    border-bottom: 0;
  }
  .prose .pubs-here .pub + .pub {
    margin-top: 0;
  }
  @media (max-width: 640px) {
    .prose .contents ol {
      columns: 1;
    }
  }
</style>
