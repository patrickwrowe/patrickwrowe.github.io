---
import type { GetStaticPaths } from "astro";
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Prose from "@/layouts/Prose.astro";
import Plate from "@/components/Plate.astro";
import DraftNotice from "@/components/DraftNotice.astro";
import { wallLabelFields, isPublished } from "@/lib/content";

export const getStaticPaths = (async () => {
  const work = await getCollection("work", isPublished);
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
---

<Prose
  title={data.title}
  description={data.summary}
  section="work"
  math={data.math}
  meta={data.year}
  fields={wallLabelFields(data)}
>
  {
    data.authors && (
      <p class="authors">
        {data.authors}
        {data.doi && (
          <>
            {" · "}
            <a href={`https://doi.org/${data.doi}`}>{data.doi}</a>
          </>
        )}
      </p>
    )
  }

  {data.stub && <DraftNotice>{data.stubNote ?? "Placeholder — this page is scaffolding, not a finished account."}</DraftNotice>}

  {
    data.hero && (
      <Plate n={1}>
        <Image src={data.hero} alt={data.heroAlt ?? ""} widths={[640, 1180]} sizes="(max-width: 700px) 100vw, 1180px" />
        <Fragment slot="caption">
          {data.heroAlt}
          {data.heroCredit && <span class="credit">{data.heroCredit}</span>}
        </Fragment>
      </Plate>
    )
  }

  <Content />

  {
    data.links.length > 0 && (
      <p class="links">
        {data.links.map((link) => (
          <a href={link.url}>{link.label} &nearr;</a>
        ))}
      </p>
    )
  }
</Prose>

<style is:global>
  /* Author list on a paper page. Mono would fight the wall label directly above it,
     so this stays serif and small — a citation, not another metadata row. */
  .prose .authors {
    font-family: var(--serif);
    font-size: var(--t-small);
    line-height: 1.5;
    color: var(--graphite);
    margin-top: 0;
    margin-bottom: 2em;
    max-width: var(--measure-prose);
  }
  .prose .authors a {
    border-bottom: 1px solid var(--hairline);
  }
  .prose .credit {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--graphite);
  }
  .prose .links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hairline);
  }
  .prose .links a {
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--graphite);
    border-bottom: 0;
    transition: color var(--transition);
  }
  .prose .links a:hover {
    color: var(--lustre);
  }
</style>
